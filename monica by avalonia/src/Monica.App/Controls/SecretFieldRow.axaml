<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:local="using:Monica.App"
             x:Class="Monica.App.Controls.SecretFieldRow"
             x:Name="Root">

    <Grid x:Name="RootGrid" ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <!-- Label column (optional) -->
        <TextBlock Grid.Column="0"
                   Text="{Binding #Root.Label}"
                   IsVisible="{Binding #Root.HasLabel}"
                   VerticalAlignment="Center" />

        <!-- Value input/display column -->
        <TextBox x:Name="ValueBox"
                 Text="{Binding #Root.Value, Mode=TwoWay}"
                 PasswordChar="{Binding #Root.MaskChar}"
                 PlaceholderText="{Binding #Root.PlaceholderText}"
                 MinHeight="{DynamicResource ControlHeight}"
                 VerticalContentAlignment="Center"
                 IsReadOnly="{Binding #Root.IsReadOnly}"
                 AutomationProperties.Name="{Binding #Root.AutomationName}" />

        <!-- Visibility toggle button -->
        <Button x:Name="ToggleVisibilityButton"
                Classes="workspaceCommand"
                Width="32"
                Height="32"
                Padding="0"
                IsVisible="{Binding #Root.ShowToggleVisibility}"
                Command="{Binding #Root.ToggleVisibilityCommand}"
                ToolTip.Tip="{Binding #Root.ToggleVisibilityTooltip}"
                AutomationProperties.Name="{Binding #Root.ToggleVisibilityAutomationName}"
                VerticalAlignment="Center">
            <Panel>
                <ic:FluentIcon Icon="Eye" FontSize="16" IsVisible="{Binding #Root.IsMasked}" />
                <ic:FluentIcon Icon="EyeOff" FontSize="16" IsVisible="{Binding #Root.IsMasked, Converter={x:Static local:BoolConverters.Not}}" />
            </Panel>
        </Button>

        <!-- Copy button (optional) -->
        <Button x:Name="CopyButton"
                Classes="workspaceCommand"
                Width="32"
                Height="32"
                Padding="0"
                IsVisible="{Binding #Root.ShowCopy}"
                Command="{Binding #Root.CopyCommand}"
                ToolTip.Tip="{Binding #Root.CopyTooltip}"
                AutomationProperties.Name="{Binding #Root.CopyAutomationName}"
                VerticalAlignment="Center">
            <ic:FluentIcon Icon="Copy" FontSize="16" />
        </Button>
    </Grid>
</UserControl>

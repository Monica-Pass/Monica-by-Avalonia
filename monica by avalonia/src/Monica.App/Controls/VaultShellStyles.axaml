<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        xmlns:fap="using:FluentAvalonia.UI.Controls.Primitives">

    <!-- Surfaces carry no fill and no stroke: the window paints exactly one
         background and panes are separated by hairlines only. -->
    <Style Selector="Button.workspaceCommand">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    </Style>
    <Style Selector="Button.workspacePrimaryCommand">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>

    <!-- Rail glyphs carry no accent of their own; they only move on the grey ramp,
         so the selected destination is the single brightest mark in the pane. -->
    <Style Selector="fa|FANavigationViewItem fa|FAImageIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="fa|FANavigationViewItem:pointerover fa|FAImageIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="fa|FANavigationViewItem:selected fa|FAImageIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <!-- The rail's accent bar would be a third accent on top of the list selection and the
         per-screen primary command, and FluentAvalonia additionally leaves the previous pane's bar
         faded-in when the selection crosses between the menu and footer panes. Selection still
         reads through the grey pill and the brighter glyph, so the bar is dropped outright. -->
    <Style Selector="fa|FANavigationViewItem /template/ fap|FANavigationViewItemPresenter /template/ Border#SelectionIndicator">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="ListBox.workspaceList ListBoxItem">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="{DynamicResource ListRowHeight}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.workspaceList ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource ListViewItemBackgroundSelected}" />
    </Style>
    <Style Selector="ListBox.workspaceList ListBoxItem WrapPanel.workspaceRowActions">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBox.workspaceList ListBoxItem:pointerover WrapPanel.workspaceRowActions">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="ListBox.workspaceList ListBoxItem:selected WrapPanel.workspaceRowActions">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Border.workspaceListRow">
        <Setter Property="Padding" Value="{DynamicResource PaddingListRow}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.workspaceListRowButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.workspaceListRowButton:pointerover">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.workspaceListRowButton:pressed">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="StackPanel.workspaceEmptyState">
        <Setter Property="Margin" Value="16" />
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.workspaceEmptyState TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeMeta}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.workspaceFailureStatus">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="Border.workspacePane">
        <Setter Property="Padding" Value="{DynamicResource PaddingPane}" />
    </Style>
    <Style Selector="Border.workspaceSidebar">
        <Setter Property="Padding" Value="{DynamicResource PaddingPane}" />
    </Style>

    <!-- A workspace splits into a header strip, an optional rail and one detail surface, and the
         only chrome between them is a hairline. Regions carry no fill of their own. -->
    <Style Selector="Border.workspaceToolbar">
        <Setter Property="Padding" Value="8" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.workspaceTreeRail">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="Border.workspaceDetail">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>

    <!-- Header chips size to their label; workspaceNavItem is a sidebar item and stretches. -->
    <Style Selector="Button.workspaceFilterChip">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.workspaceFilterChip:pointerover">
        <Setter Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
    </Style>
    <Style Selector="Button.workspaceFilterChip.selected">
        <Setter Property="Background" Value="{DynamicResource ListViewItemBackgroundSelected}" />
    </Style>

    <!-- Status chips are plain meta text; keeping the class name avoids touching
         every call site while dropping the pill chrome in one place. -->
    <Style Selector="Border.workspaceStatusChip">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.workspaceStatusChip TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeMeta}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style Selector="Button.workspaceNavItem">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.workspaceNavItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}" />
    </Style>
    <Style Selector="Button.workspaceNavItem.selected">
        <Setter Property="Background" Value="{DynamicResource ListViewItemBackgroundSelected}" />
    </Style>

    <Style Selector="TextBlock.workspacePageTitle">
        <Setter Property="FontSize" Value="{DynamicResource FontSizePageTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.workspaceItemTitle">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.workspacePageSubtitle">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeMeta}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.workspaceSectionLabel">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeMeta}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.workspaceDetailLabel">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeMeta}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.workspaceDetailValue">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.workspaceMeta">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeMeta}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Button.workspaceCommand:pointerover">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.workspacePrimaryCommand:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="Button.workspacePrimaryCommand TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="ListBox.workspaceList ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Border.workspaceListRow.compact">
        <Setter Property="MinHeight" Value="56" />
    </Style>
    <Style Selector="Border.workspaceNavItem">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.workspaceNavItem.selected">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>

    <!-- Win11-shaped scrollbars: a slim floating thumb over no track and no arrow buttons.
         FluentAvalonia sizes its bars from the Windows UISettings COM interop rather than from
         application resources, so the only way to change the shape is to own the template.
         Measured before this: a vertical bar rendered 14px wide with two visible 14x10 arrow
         buttons, and the app-level ScrollBarSize/ScrollBarArrowSize knobs changed nothing. -->
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent">
                    <Track Name="PART_Track"
                           IsDirectionReversed="True"
                           Maximum="{TemplateBinding Maximum}"
                           Minimum="{TemplateBinding Minimum}"
                           Orientation="Vertical"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           ViewportSize="{TemplateBinding ViewportSize}">
                        <Track.DecreaseButton>
                            <RepeatButton Name="PART_PageUpButton" Classes="slimScrollBarPage" Focusable="False" />
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton Name="PART_PageDownButton" Classes="slimScrollBarPage" Focusable="False" />
                        </Track.IncreaseButton>
                        <Thumb Name="slimThumb" Margin="4,0" MinHeight="28" />
                    </Track>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent">
                    <Track Name="PART_Track"
                           Maximum="{TemplateBinding Maximum}"
                           Minimum="{TemplateBinding Minimum}"
                           Orientation="Horizontal"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           ViewportSize="{TemplateBinding ViewportSize}">
                        <Track.DecreaseButton>
                            <RepeatButton Name="PART_PageUpButton" Classes="slimScrollBarPage" Focusable="False" />
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton Name="PART_PageDownButton" Classes="slimScrollBarPage" Focusable="False" />
                        </Track.IncreaseButton>
                        <Thumb Name="slimThumb" Margin="0,4" MinWidth="28" />
                    </Track>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <!-- The page buttons stay live (clicking the channel still pages) but paint nothing, which is
         what removes the grey trough the old bar drew behind the thumb. -->
    <Style Selector="ScrollBar /template/ RepeatButton.slimScrollBarPage">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ScrollBar /template/ Thumb#slimThumb">
        <Setter Property="Background" Value="{DynamicResource SlimScrollBarThumbBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="2" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Thumb#slimThumb:pointerover">
        <Setter Property="Margin" Value="2,0" />
    </Style>
    <Style Selector="ScrollBar:horizontal /template/ Thumb#slimThumb:pointerover">
        <Setter Property="Margin" Value="0,2" />
    </Style>
</Styles>

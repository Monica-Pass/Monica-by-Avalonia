<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Panes carry no fill: the only strokes on this screen are the two hairlines below,
         and the folder rail paints its own selection. -->
    <Style Selector="ToggleButton.passwordFilterOption">
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="ToggleButton.passwordFilterOption:checked">
        <Setter Property="Background" Value="{DynamicResource ListViewItemBackgroundSelected}" />
    </Style>
    <Style Selector="Border.passwordChromeToolbar">
        <Setter Property="Padding" Value="8" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.passwordFolderNavigationRegion">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="Border.passwordListRegion">
        <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Border.passwordDetailRegion">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
    <Style Selector="ListBox.passwordVaultList ListBoxItem">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="{DynamicResource ListRowHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.passwordVaultList ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource ListViewItemBackgroundSelected}" />
    </Style>
    <Style Selector="ListBox.passwordVaultList ListBoxItem:selected /template/ Border#SelectionIndicator">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBox.passwordVaultList ListBoxItem:selected /template/ Border#SelectedPipe">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBox.passwordVaultList ListBoxItem:selected /template/ Rectangle#SelectionIndicator">
        <Setter Property="IsVisible" Value="False" />
    </Style>
</Styles>

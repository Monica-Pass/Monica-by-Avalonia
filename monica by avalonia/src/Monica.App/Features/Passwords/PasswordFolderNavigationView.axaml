<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Monica.App.Controls"
             xmlns:vm="using:Monica.App.ViewModels"
             x:Class="Monica.App.Features.Passwords.PasswordFolderNavigationView"
             x:Name="Root"
             x:DataType="vm:MainWindowViewModel">
    <!-- The rail filters; 收藏 / 无文件夹 live in the toolbar filter panel, so the
         system nodes stay out of this list and the header carries the reset. -->
    <controls:VaultFolderTree x:Name="PasswordFolderTree"
                             ItemsSource="{Binding RegularPasswordFolderFilters}"
                             SelectedItem="{Binding SelectedPasswordFolderFilter, Mode=TwoWay}"
                             AllFoldersCommand="{Binding ShowAllPasswordFoldersCommand}"
                             IsAllFoldersSelected="{Binding IsAllPasswordFoldersSelected}"
                             ToggleExpansionCommand="{Binding TogglePasswordFolderExpansionCommand}"
                             CreateFolderCommand="{Binding CreatePasswordFolderCommand}"
                             RenameFolderCommand="{Binding RenameSelectedPasswordFolderCommand}"
                             DeleteFolderCommand="{Binding DeleteSelectedPasswordFolderCommand}"
                             MoveFolderCommand="{Binding MovePasswordFolderCommand}"
                             CanManageSelected="{Binding CanManageSelectedPasswordFolder}"
                             FolderName="{Binding NewFolderName, Mode=TwoWay}" />
</UserControl>

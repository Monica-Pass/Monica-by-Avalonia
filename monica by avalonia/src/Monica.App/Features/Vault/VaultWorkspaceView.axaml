<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:controls="using:Monica.App.Controls"
             xmlns:vm="using:Monica.App.ViewModels"
             x:Class="Monica.App.Features.Vault.VaultWorkspaceView"
             x:Name="Root"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <!-- The right-hand slot hosts the other pages' editors, and each of those resolves its
             own class names through the feature stylesheet it is normally nested in. -->
        <StyleInclude Source="/Features/Passwords/PasswordVaultStyles.axaml" />
        <StyleInclude Source="/Features/Notes/NoteStyles.axaml" />
        <StyleInclude Source="/Features/Authenticator/AuthenticatorStyles.axaml" />
        <StyleInclude Source="/Features/Wallet/WalletStyles.axaml" />
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- One strip for everything that narrows the tree; the tree itself is the only navigator. -->
        <Border Grid.Row="0" Classes="workspaceToolbar">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <TextBlock Classes="workspacePageTitle"
                           Text="{Binding L.Library}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Spacing="4">
                    <Button Classes="workspaceFilterChip"
                            Classes.selected="{Binding VaultFavoritesOnly}"
                            Content="{Binding L.LibraryFavorites}"
                            Command="{Binding ToggleVaultFavoritesCommand}" />
                    <!-- Sort keys and quick filters belong to the tree, not to a toolbar of their own,
                         so they live behind one chip that lights up when one of them is on. -->
                    <Button x:Name="VaultMoreButton"
                            Classes="workspaceFilterChip"
                            Classes.selected="{Binding HasVaultQuickFilters}"
                            Content="{Binding L.LibraryMore}"
                            ToolTip.Tip="{Binding VaultMoreButtonTip}"
                            AutomationProperties.Name="{Binding L.LibraryMore}">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="{Binding L.LibrarySort}">
                                    <MenuItem.Icon>
                                        <ic:FluentIcon Icon="ArrowSort" FontSize="14" />
                                    </MenuItem.Icon>
                                    <MenuItem.Items>
                                        <MenuItem Header="{Binding SortUpdatedText}" ToggleType="Radio" IsChecked="{Binding IsSortUpdatedSelected}"
                                                  Command="{Binding SetPasswordSortCommand}" CommandParameter="updated-desc" />
                                        <MenuItem Header="{Binding SortTitleText}" ToggleType="Radio" IsChecked="{Binding IsSortTitleSelected}"
                                                  Command="{Binding SetPasswordSortCommand}" CommandParameter="title-asc" />
                                        <MenuItem Header="{Binding SortWebsiteText}" ToggleType="Radio" IsChecked="{Binding IsSortWebsiteSelected}"
                                                  IsVisible="{Binding IsVaultPasswordsPreset}"
                                                  Command="{Binding SetPasswordSortCommand}" CommandParameter="website-asc" />
                                        <MenuItem Header="{Binding SortUsernameText}" ToggleType="Radio" IsChecked="{Binding IsSortUsernameSelected}"
                                                  IsVisible="{Binding IsVaultPasswordsPreset}"
                                                  Command="{Binding SetPasswordSortCommand}" CommandParameter="username-asc" />
                                        <MenuItem Header="{Binding SortCreatedText}" ToggleType="Radio" IsChecked="{Binding IsSortCreatedSelected}"
                                                  Command="{Binding SetPasswordSortCommand}" CommandParameter="created-desc" />
                                        <MenuItem Header="{Binding SortFavoritesText}" ToggleType="Radio" IsChecked="{Binding IsSortFavoritesSelected}"
                                                  Command="{Binding SetPasswordSortCommand}" CommandParameter="favorites-first" />
                                    </MenuItem.Items>
                                </MenuItem>
                                <MenuItem Header="{Binding L.PasswordFilters}" IsVisible="{Binding IsVaultPasswordsPreset}">
                                    <MenuItem.Icon>
                                        <ic:FluentIcon Icon="Filter" FontSize="14" />
                                    </MenuItem.Icon>
                                    <MenuItem.Items>
                                        <MenuItem Header="{Binding L.QuickFilter2Fa}" ToggleType="CheckBox" IsChecked="{Binding QuickFilter2Fa, Mode=TwoWay}">
                                            <MenuItem.Icon><ic:FluentIcon Icon="Key" FontSize="14" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{Binding L.QuickFilterNotes}" ToggleType="CheckBox" IsChecked="{Binding QuickFilterNotes, Mode=TwoWay}">
                                            <MenuItem.Icon><ic:FluentIcon Icon="Note" FontSize="14" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{Binding L.QuickFilterPasskey}" ToggleType="CheckBox" IsChecked="{Binding QuickFilterPasskey, Mode=TwoWay}">
                                            <MenuItem.Icon><ic:FluentIcon Icon="Fingerprint" FontSize="14" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{Binding L.QuickFilterBoundNote}" ToggleType="CheckBox" IsChecked="{Binding QuickFilterBoundNote, Mode=TwoWay}">
                                            <MenuItem.Icon><ic:FluentIcon Icon="Document" FontSize="14" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{Binding L.QuickFilterUncategorized}" ToggleType="CheckBox" IsChecked="{Binding QuickFilterUncategorized, Mode=TwoWay}">
                                            <MenuItem.Icon><ic:FluentIcon Icon="Folder" FontSize="14" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{Binding L.QuickFilterLocalOnly}" ToggleType="CheckBox" IsChecked="{Binding QuickFilterLocalOnly, Mode=TwoWay}">
                                            <MenuItem.Icon><ic:FluentIcon Icon="Desktop" FontSize="14" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{Binding L.QuickFilterAttachments}" ToggleType="CheckBox" IsChecked="{Binding QuickFilterAttachments, Mode=TwoWay}">
                                            <MenuItem.Icon><ic:FluentIcon Icon="Attach" FontSize="14" /></MenuItem.Icon>
                                        </MenuItem>
                                    </MenuItem.Items>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <!-- The check marks live on the entries, so this chip appears the moment any row is
                         checked and says how many the actions below will sweep up. -->
                    <Button x:Name="VaultBatchButton"
                            Classes="workspaceFilterChip"
                            IsVisible="{Binding HasVaultBatchSelection}"
                            Content="{Binding VaultBatchLabel}"
                            AutomationProperties.Name="{Binding VaultBatchLabel}">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="{Binding L.BatchMove}"
                                          Command="{Binding MoveVaultBatchToFolderCommand}">
                                    <MenuItem.Icon><ic:FluentIcon Icon="Folder" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{Binding L.BatchFavorite}"
                                          IsVisible="{Binding VaultBatchSupportsFavorite}"
                                          Command="{Binding FavoriteVaultBatchCommand}">
                                    <MenuItem.Icon><ic:FluentIcon Icon="Star" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{Binding L.BatchArchive}"
                                          IsVisible="{Binding VaultBatchSupportsArchive}"
                                          Command="{Binding ArchiveVaultBatchCommand}">
                                    <MenuItem.Icon><ic:FluentIcon Icon="Archive" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{Binding L.BatchDelete}"
                                          Command="{Binding DeleteVaultBatchCommand}">
                                    <MenuItem.Icon><ic:FluentIcon Icon="Delete" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{Binding L.BatchSelectAll}"
                                          Command="{Binding SelectAllVaultRowsCommand}" />
                                <MenuItem Header="{Binding L.BatchClear}"
                                          Command="{Binding ClearVaultBatchSelectionCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <TextBox x:Name="VaultSearchBox"
                             Text="{Binding VaultSearchText, Mode=TwoWay}"
                             PlaceholderText="{Binding L.Search}"
                             Width="200"
                             MinHeight="{DynamicResource ControlHeight}"
                             VerticalContentAlignment="Center"
                             AutomationProperties.Name="{Binding L.Search}" />
                    <Button Classes="workspaceCommand"
                            IsVisible="{Binding HasVaultSearchText}"
                            Command="{Binding ClearVaultSearchCommand}"
                            ToolTip.Tip="{Binding L.ClearSearch}"
                            AutomationProperties.Name="{Binding L.ClearSearch}"
                            VerticalAlignment="Center">
                        <ic:FluentIcon Icon="Dismiss" FontSize="14" />
                    </Button>
                    <Button x:Name="VaultCreatePresetButton"
                            Classes="workspacePrimaryCommand"
                            IsVisible="{Binding HasVaultCreatePreset}"
                            Command="{Binding VaultCreateCommand}"
                            ToolTip.Tip="{Binding VaultCreateLabel}"
                            AutomationProperties.Name="{Binding VaultCreateLabel}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:FluentIcon Icon="Add" FontSize="16" />
                            <TextBlock Text="{Binding VaultCreateLabel}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="VaultCreateMenuButton"
                            Classes="workspacePrimaryCommand"
                            IsVisible="{Binding !HasVaultCreatePreset}"
                            ToolTip.Tip="{Binding L.LibraryCreate}"
                            AutomationProperties.Name="{Binding L.LibraryCreate}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:FluentIcon Icon="Add" FontSize="16" />
                            <TextBlock Text="{Binding L.LibraryCreate}" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="{Binding L.AddPassword}" Command="{Binding AddPasswordCommand}">
                                    <MenuItem.Icon><ic:FluentIcon Icon="Key" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{Binding L.NewSecureNote}" Command="{Binding AddNoteCommand}">
                                    <MenuItem.Icon><ic:FluentIcon Icon="Note" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{Binding L.AddAuthenticator}" Command="{Binding AddTotpCommand}">
                                    <MenuItem.Icon><ic:FluentIcon Icon="Fingerprint" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{Binding L.AddWalletItem}" Command="{Binding AddWalletItemCommand}">
                                    <MenuItem.Icon><ic:FluentIcon Icon="WalletCreditCard" FontSize="14" /></MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="340,*">
            <Border Grid.Column="0" Classes="workspaceTreeRail">
                <Panel>
                    <controls:VaultFolderTree x:Name="VaultTree"
                                              Text="{Binding L}"
                                              ItemsSource="{Binding VaultTreeRows}"
                                              SelectedItem="{Binding SelectedVaultRow, Mode=TwoWay}"
                                              ToggleExpansionCommand="{Binding ToggleVaultFolderExpansionCommand}"
                                              CreateFolderCommand="{Binding CreateVaultFolderCommand}"
                                              RenameFolderCommand="{Binding RenameSelectedVaultFolderCommand}"
                                              DeleteFolderCommand="{Binding DeleteSelectedVaultFolderCommand}"
                                              MoveFolderCommand="{Binding MoveVaultFolderCommand}"
                                              CanManageSelected="{Binding CanManageSelectedVaultFolder}"
                                              FolderName="{Binding NewFolderName, Mode=TwoWay}"
                                              EditEntryCommand="{Binding EditSelectedVaultEntryCommand}"
                                              MoveEntryCommand="{Binding MoveSelectedVaultEntryCommand}"
                                              DeleteEntryCommand="{Binding DeleteSelectedVaultEntryCommand}"
                                              CopyRowUsernameCommand="{Binding CopyRowUsernameCommand}"
                                              CopyRowSecretCommand="{Binding CopyRowSecretCommand}"
                                              CopyRowCodeCommand="{Binding CopyRowCodeCommand}" />
                    <TextBlock Classes="workspaceMeta"
                               IsVisible="{Binding !HasVaultRows}"
                               Text="{Binding VaultEmptyStateText}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Panel>
            </Border>

            <!-- The page owns no editing surface: whatever the selected row names opens here. -->
            <Border Grid.Column="1" Classes="workspaceDetail">
                <Panel>
                    <ContentControl x:Name="VaultSurfaceHost"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />
                    <TextBlock Classes="workspaceMeta"
                               IsVisible="{Binding !HasVaultSelection}"
                               Text="{Binding L.LibraryOpenHint}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Panel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
